# Copy to .env and fill in what you need. Empty values use the defaults from design/ports.md.
CQA_LLM_MODE=
CQA_LLM_BASE_URL=
CQA_LLM_API_KEY=
CQA_LLM_MODEL=
CQA_LLM_PROFILE=
CQA_LLM_REASONING=
CQA_LLM_MAX_PARALLEL=
CQA_LLM_RPM=
CQA_LLM_TIMEOUT_S=
CQA_LLM_PRICE_IN=
CQA_LLM_PRICE_OUT=
CQA_VERIFIER=
CQA_JEV_API_KEY=
CQA_ANONYMIZE=
CQA_DATA_WHERE=
# set only by a human
CQA_ALLOW_REAL_DATA=
CQA_ORG_API_URL=
CQA_RAW_DIR=
CQA_AUDIO_SHIFT_S=
CQA_AUDIO_SHIFT_PAUSED_S=
CQA_DB_PATH=
CQA_EVAL_DATASET=
CQA_HOLDOUT_DIR=

# --- Сценарий 4 (по умолчанию, docs/plan.md): Qwen у провайдера в РК, без второго мнения ---
# CQA_LLM_MODE=live
# CQA_LLM_BASE_URL=https://llm.alem.ai/v1
# CQA_LLM_API_KEY=<ключ>
# CQA_LLM_PROFILE=plain
# CQA_LLM_REASONING=on
# CQA_LLM_MAX_PARALLEL=4
# CQA_LLM_RPM=120
# CQA_DATA_WHERE=kz

# --- Сценарий 5 (запасной): DeepSeek V4 Pro + второе мнение Jev, без лимита в минуту ---
# CQA_LLM_MODE=live
# CQA_LLM_BASE_URL=https://api.deepseek.com
# CQA_LLM_API_KEY=<ключ>
# CQA_LLM_MODEL=<имя модели V4 Pro у DeepSeek>
