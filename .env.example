# Скопируйте в .env и заполните нужное: cp .env.example .env
# Пустые значения берут умолчания из src/cqa/settings.py (таблица «Settings» в design/ports.md).
# О запуске — README.md, о контрольном часе и защите — docs/runbook.md.
# Ключи и адрес API организаторов в этот файл не пишем: только имена переменных.

# --- Модель (replay: записанные ответы из tests/cassettes, без сети) ---
CQA_LLM_MODE=
# адрес OpenAI-совместимого API, например https://llm.alem.ai/v1 (сценарий 4 ниже)
CQA_LLM_BASE_URL=
CQA_LLM_API_KEY=
# имя модели у провайдера (умолчание qwen3-6) или на локальном сервере
CQA_LLM_MODEL=
# параметры запросов: plain (без extras) или deepseek; см. src/cqa/adapters/llm.py
CQA_LLM_PROFILE=
# on: рассуждение модели, off: строгий JSON
CQA_LLM_REASONING=
CQA_LLM_MAX_PARALLEL=
# 0: без лимита запросов в минуту
CQA_LLM_RPM=
CQA_LLM_TIMEOUT_S=
# USD за 1M токенов, вход и выход: для цены в карточках; 0 — цена не считается
CQA_LLM_PRICE_IN=
CQA_LLM_PRICE_OUT=
# основная модель: код провайдера (умолчание env — модель из CQA_LLM_* выше)
CQA_LLM_PROVIDER=
# ещё провайдеры OpenAI-формата со своими ключами, JSON {"код": {label, base_url, model, profile, where, key}};
# обычно их заводят в окне режима, список из интерфейса заменяет этот
CQA_PROVIDERS=
# ключ OpenRouter для встроенного провайдера openrouter-jev (Jev Router через OpenRouter, раздел в README)
CQA_OPENROUTER_API_KEY=

# --- Второе мнение (выключено, пока пусто): jev или код провайдера ---
CQA_VERIFIER=
CQA_JEV_API_KEY=
# llm (по умолчанию) или jev: все критерии отвечает только Jev, быстро и без обоснований
CQA_EVALUATOR=

# --- Данные ---
# обезличивание до отправки модели (включено по умолчанию)
CQA_ANONYMIZE=
# где обрабатываются данные: kz, local, external (плашка в шапке интерфейса)
CQA_DATA_WHERE=
# ставить только человеку: разрешает отправку реальных звонков в модель
CQA_ALLOW_REAL_DATA=
# адрес API организаторов (не публикуем), пусто — набор только файлом
CQA_ORG_API_URL=
# каталог снимков конвертов организаторов (data/raw по умолчанию)
CQA_RAW_DIR=
CQA_AUDIO_SHIFT_S=
CQA_AUDIO_SHIFT_PAUSED_S=
CQA_DB_PATH=
# снимок DEV для scripts/demo.py pick и make eval (data/dev.json)
CQA_EVAL_DATASET=
# каталог отложенных критериев вне репозитория для make eval-holdout
CQA_HOLDOUT_DIR=
# интеграционный API: POST события run.finished по концу запуска; секрет — подпись X-CQA-Signature (HMAC-SHA256)
CQA_WEBHOOK_URL=
CQA_WEBHOOK_SECRET=

# --- Сценарий 4 (основной, см. README): Qwen у провайдера в РК, без второго мнения ---
# CQA_LLM_MODE=live
# CQA_LLM_BASE_URL=https://llm.alem.ai/v1
# CQA_LLM_API_KEY=<ключ>
# CQA_LLM_PROFILE=plain
# CQA_LLM_REASONING=on
# CQA_LLM_MAX_PARALLEL=4
# CQA_LLM_RPM=120
# CQA_DATA_WHERE=kz

# --- Сценарий 5 (запасной): DeepSeek V4 Pro + второе мнение Jev, без лимита в минуту ---
# CQA_LLM_MODE=live
# CQA_LLM_BASE_URL=https://api.deepseek.com
# CQA_LLM_API_KEY=<ключ>
# CQA_LLM_MODEL=<имя модели V4 Pro у DeepSeek>
# CQA_LLM_PROFILE=deepseek
# CQA_LLM_REASONING=on
# CQA_LLM_MAX_PARALLEL=64
# CQA_LLM_RPM=0
# CQA_LLM_PRICE_IN=0.435
# CQA_LLM_PRICE_OUT=0.87
# CQA_VERIFIER=jev
# CQA_JEV_API_KEY=<ключ>
# CQA_DATA_WHERE=external

# --- Сценарий 6: локальная модель через OpenAI-совместимый сервер (раздел «Локальная модель» в README) ---
# Подходит Ollama, vLLM, LM Studio: адрес их /v1, имя модели с сервера, ключ не нужен,
# но проверка конфигурации требует непустой CQA_LLM_API_KEY — подойдёт любая строка.
# CQA_LLM_MODE=live
# CQA_LLM_BASE_URL=http://localhost:11434/v1
# CQA_LLM_API_KEY=local
# CQA_LLM_MODEL=<имя модели на сервере, например qwen3:8b>
# CQA_LLM_PROFILE=plain
# CQA_LLM_REASONING=off
# CQA_DATA_WHERE=local
